# Twilio Credentials (Get from https://console.twilio.com)
TWILIO_ACCOUNT_SID=your_account_sid_here
TWILIO_AUTH_TOKEN=your_auth_token_here
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

# WhatsApp Default Recipient (Your phone number or sales manager)
# This is used when no specific recipient is provided in API calls
WHATSAPP_RECIPIENT=+1234567890

# Groq AI API Key (Get from https://console.groq.com)
GROQ_API_KEY=your_groq_api_key_here

# Optional: Deploy URL (for production)
# API_BASE_URL=https://your-app.com

# NOTE: You can send to ANY number via the API by passing ?recipient=+1234567890
# The default recipient above is only used when no recipient is specified
